<%- include('partials/header') %>

<h2>Inscripción en Taller</h2>
<h3><%= taller.titulo %></h3>

<% if (errores.taller || errores.plazas) { %>
  <p class="alerta-error"><%= errores.taller || errores.plazas %></p>
  <p><a href="/talleres/<%= taller.id %>">&larr; Volver a la ficha del taller</a></p>
<% } else { %>
  <!-- Formulario POST hacia la ruta de procesamiento -->
  <form action="/talleres/<%= taller.id %>/inscripcion" method="post" class="form-inscripcion" novalidate>
    
    <div class="campo-form">
      <label for="nombre">Nombre completo:</label>
      <!-- Conservación de valor ingresado con salida escapada <%= %> -->
      <input 
        type="text" 
        id="nombre" 
        name="nombre" 
        value="<%= valores.nombre || '' %>"
        class="<%= errores.nombre ? 'input-error' : '' %>"
      >
      <% if (errores.nombre) { %>
        <p class="mensaje-error"><%= errores.nombre %></p>
      <% } %>
    </div>

    <div class="campo-form">
      <label for="email">Correo electrónico:</label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        value="<%= valores.email || '' %>"
        class="<%= errores.email ? 'input-error' : '' %>"
      >
      <% if (errores.email) { %>
        <p class="mensaje-error"><%= errores.email %></p>
      <% } %>
    </div>

    <button type="submit" class="btn-guardar">Confirmar Inscripción</button>
    <a href="/talleres/<%= taller.id %>" class="btn-cancelar">Cancelar</a>
  </form>
<% } %>

<%- include('partials/footer') %>