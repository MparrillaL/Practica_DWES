<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jornadas Tecnológicas - Inscripción a Talleres</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; padding: 0; background-color: #f4f6f8; color: #333; }
    header { background-color: #1e293b; color: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    header h1 { margin: 0; font-size: 1.5rem; }
    nav a { color: #f8fafc; text-decoration: none; margin-left: 1rem; font-weight: bold; }
    nav a:hover { text-decoration: underline; }
    main { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
    .badge { padding: 0.25rem 0.5rem; border-radius: 4px; font-weight: bold; font-size: 0.85rem; }
    .badge-disponible { background-color: #dcfce7; color: #166534; }
    .badge-ultima { background-color: #fef3c7; color: #92400e; }
    .badge-completo { background-color: #fee2e2; color: #991b1b; }
    .btn { display: inline-block; background-color: #2563eb; color: white; padding: 0.5rem 1rem; text-decoration: none; border-radius: 4px; border: none; cursor: pointer; }
    .btn:hover { background-color: #1d4ed8; }
    .error-msg { color: #dc2626; font-size: 0.875rem; margin-top: 0.25rem; }
    .alerta, .alerta-error { padding: 0.75rem 1rem; border-radius: 4px; background-color: #fee2e2; color: #991b1b; }
    .mensaje-error { color: #dc2626; font-size: 0.875rem; margin: 0.25rem 0 0; }
    .input-error { border: 2px solid #dc2626; }
    .lista-talleres { list-style: none; padding: 0; }
    .lista-talleres li { background: white; padding: 0.5rem 1rem; margin-bottom: 1rem; border-radius: 4px; }
    .campo-form { margin-bottom: 1rem; }
    .campo-form input { display: block; padding: 0.4rem; width: 100%; max-width: 350px; }
    .estado { padding: 0.25rem 0.5rem; border-radius: 4px; font-weight: bold; display: inline-block; }
    .estado.disponible { background-color: #dcfce7; color: #166534; }
    .estado.ultima-plaza { background-color: #fef3c7; color: #92400e; }
    .estado.completo { background-color: #fee2e2; color: #991b1b; }
    .btn-inscripcion, .btn-guardar { display: inline-block; background-color: #2563eb; color: white; padding: 0.5rem 1rem; text-decoration: none; border-radius: 4px; border: none; cursor: pointer; }
    .form-filtros { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  </style>
</head>
<body>
  <header>
    <h1>Jornadas Tecnológicas</h1>
    <nav>
      <a href="/talleres">Ver Talleres</a>
    </nav>
  </header>
  <main>